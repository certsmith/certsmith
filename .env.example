# ==========================================
# CERTSMITH CONFIGURATION (.env)
# ==========================================
#
# IMPORTANT: ALL variables below are REQUIRED.
# There are NO fallback defaults. The system will
# refuse to start if any variable is missing or empty.
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ==========================================

# ------------------------------------------
# 1. Global Server Settings
# ------------------------------------------
# Comma-separated list of domains/FQDNs for this ACME server.
# The FIRST domain is the PRIMARY (used as Subject CN and main identifier).
# Supports wildcards (e.g. *.example.com) — signed by internal CA, no DNS-01 needed.
# Backward compatible: CERTSMITH_DOMAIN (single) is also accepted if CERTSMITH_DOMAINS is unset.
#
# Example multi-domain:
#   CERTSMITH_DOMAINS=acme.example.com,acme.internal.local,*.example.com
CERTSMITH_DOMAINS=acme.homelab.internal

# Host-mapped ports for HTTP and HTTPS.
CERTSMITH_PORT_HTTP=80
CERTSMITH_PORT_HTTPS=443

# ------------------------------------------
# 2. X.509 Base Subject DN
# ------------------------------------------
# These fields are shared across ALL certificates
# (Root CA and all 6 Intermediate CAs).
CA_COUNTRY="ID"
CA_STATE="DKI Jakarta"
CA_LOCALITY="Jakarta Selatan"
CA_ORGANIZATION="Certsmith Security Authority"
CA_ORGANIZATIONAL_UNIT="Certificate Infrastructure Division"

# ------------------------------------------
# 3. Root CA Specifications
# ------------------------------------------
# The Root CA is generated OFFLINE via certsmith-forge.sh.
# Its private key must be kept air-gapped after signing intermediates.
ROOT_CA_CN="Certsmith Root Authority G1"
ROOT_CA_KEY_TYPE=RSA
ROOT_CA_KEY_BITS=4096
ROOT_CA_VALIDITY_YEARS=30

# ------------------------------------------
# 4. Intermediate RSA Tier 1: CR1
# ------------------------------------------
# Maximum Security / Long Term (RSA 4096-bit)
CR1_CN="Certsmith RSA Issuing Authority CR1"
CR1_KEY_TYPE=RSA
CR1_KEY_BITS=4096
CR1_VALIDITY_YEARS=20
CR1_PORT=9101

# ------------------------------------------
# 5. Intermediate RSA Tier 2: CR2
# ------------------------------------------
# Enterprise Standard (RSA 3072-bit)
CR2_CN="Certsmith RSA Issuing Authority CR2"
CR2_KEY_TYPE=RSA
CR2_KEY_BITS=3072
CR2_VALIDITY_YEARS=15
CR2_PORT=9102

# ------------------------------------------
# 6. Intermediate RSA Tier 3: CR3
# ------------------------------------------
# High Performance / Legacy Compatibility (RSA 2048-bit)
CR3_CN="Certsmith RSA Issuing Authority CR3"
CR3_KEY_TYPE=RSA
CR3_KEY_BITS=2048
CR3_VALIDITY_YEARS=10
CR3_PORT=9103

# ------------------------------------------
# 7. Intermediate ECC Tier 1: CE1
# ------------------------------------------
# High Assurance Elliptic Curve (ECDSA P-384)
CE1_CN="Certsmith ECC Issuing Authority CE1"
CE1_KEY_TYPE=ECDSA
CE1_KEY_CURVE=P-384
CE1_VALIDITY_YEARS=18
CE1_PORT=9201

# ------------------------------------------
# 8. Intermediate ECC Tier 2: CE2
# ------------------------------------------
# Modern Default / Fast & Lightweight (ECDSA P-256)
CE2_CN="Certsmith ECC Issuing Authority CE2"
CE2_KEY_TYPE=ECDSA
CE2_KEY_CURVE=P-256
CE2_VALIDITY_YEARS=13
CE2_PORT=9202

# ------------------------------------------
# 9. Intermediate ECC Tier 3: CE3
# ------------------------------------------
# Ultra-Grade Elliptic Curve (ECDSA P-521)
CE3_CN="Certsmith ECC Issuing Authority CE3"
CE3_KEY_TYPE=ECDSA
CE3_KEY_CURVE=P-521
CE3_VALIDITY_YEARS=20
CE3_PORT=9203
