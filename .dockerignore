# ==========================================
# .dockerignore — Certsmith
# ==========================================
# Prevents sensitive files and unnecessary data
# from being included in the Docker build context.
# ==========================================

# Environment secrets (only .env.example is needed)
.env
.env.local
*.env
!.env.example

# Certificates and private keys
*.key
*.pem
*.crt
*.cer
*.der
*.p12
*.pfx
*.srl

# Runtime data
data/
secrets/
certs/

# Version control
.git/
.github/
.gitignore
.gitattributes

# Editor files
.DS_Store
Thumbs.db
*.swp
*~
tmp/
.idea/
.vscode/

# Documentation (not needed in image)
*.md
!README.md

# Logs
*.log
logs/

# Agents config
.agents/

# Node / Frontend Build artifacts
node_modules/
**/node_modules/
build/
**/build/
.react-router/
**/.react-router/
*.tsbuildinfo
packages/
